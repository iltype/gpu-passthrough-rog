[Unit]
Description=Bind GPU to vfio-pci before the display manager starts (if requested)
DefaultDependencies=no
Before=ly@tty1.service display-manager.service cardwired.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gpu-vfio-boot.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
